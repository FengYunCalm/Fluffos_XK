// #1247 A.3 rule-3 regression tests: runtime paths of ported fixes that were
// not covered by the upstream test files (batch8). Each assertion exercises
// the fixed boundary directly.
void do_tests() {
  // INTERP-2/3: INT64_MIN / -1 and % -1 at runtime must not trap (SIGFPE).
  int a = -9223372036854775807 - 1;
  ASSERT_EQ(-9223372036854775807 - 1, a / -1);
  ASSERT_EQ(0, a % -1);

  // CALLOUT-2: delay saturation -- huge delays must clamp, not overflow.
  call_out( (: 1 :), 0x7fffffffffffffff);
  call_out( (: 1 :), -5);
  ASSERT(1);

  // MAPPING-1 (compose): mapping * mapping keeps m1's entries whose value
  // equals an m2 key, with m2's value (compose_mapping join semantics);
  // mapping equality is pointer-based, so assert via sizeof/key lookup.
  ASSERT_EQ(0, sizeof(([ ]) * ([ ])));
  ASSERT_EQ(0, sizeof(([ "k" : 1 ]) * ([ ])));
  mapping mm = ([ "k" : 1 ]) * ([ 1 : 2 ]);
  ASSERT_EQ(1, sizeof(mm));
  ASSERT_EQ(2, mm["k"]);
  ASSERT_EQ(0, sizeof(([ "k" : 1 ]) * ([ "x" : 2 ])));

  // COMPRESS-1: compress/uncompress of ordinary data must round-trip and
  // must not leak or crash (f_compress returns a buffer).
  buffer c = compress("The quick brown fox jumps over the lazy dog");
  ASSERT(c);
  buffer d = uncompress(c);
  ASSERT_EQ(strlen("The quick brown fox jumps over the lazy dog"), sizeof(d));
  // A garbage buffer hits the f_uncompress error path (the FREE(output_data)
  // fix in COMPRESS-1), which must error out cleanly.
  mixed err = catch(uncompress(allocate_buffer(4)));
  ASSERT(err);

  // TIME-1 (strftime): a long format string must not overrun.
  string fmt = "";
  for (int i = 0; i < 200; i++) fmt += "%Y";
  string s = strftime(fmt, time());
  ASSERT(strlen(s) > 0);

  // Long get_dir path must not overflow a fixed buffer; ENOENT error or
  // empty result both fine, crash/leak caught by the ASan gate.
  string longdir = "/single/tests/efuns/";
  for (int i = 0; i < 40; i++) longdir += "d/";
  mixed r = catch(get_dir(longdir));
  ASSERT(1);  // must not crash; leak tracked by ASan gate

  ASSERT(1);
}
