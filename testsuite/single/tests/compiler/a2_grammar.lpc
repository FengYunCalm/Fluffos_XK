// #1247 A-S2: constant-fold INT_MIN (INT64_MIN) division/modulo by -1 must
// not trap (SIGFPE) in either constant-fold path (expr0 and switch-case
// `constant`), and `foo(void ...)` must be a compile error instead of an
// OOB read of type_of_locals_ptr[-1].
int switch_div(int v) {
  switch (v) {
    case (-9223372036854775807 - 1) / -1:  // INT64_MIN / -1 -> wrapped INT64_MIN
      return 1;
    default:
      return 0;
  }
}

int switch_mod(int v) {
  switch (v) {
    case (-9223372036854775807 - 1) % -1:  // INT64_MIN % -1 -> 0
      return 1;
    default:
      return 0;
  }
}

void do_tests() {
  // expr0 constant-fold path.
  ASSERT_EQ(-9223372036854775807 - 1, (-9223372036854775807 - 1) / -1);
  ASSERT_EQ(0, (-9223372036854775807 - 1) % -1);

  // switch-case `constant` path.
  ASSERT_EQ(1, switch_div(-9223372036854775807 - 1));
  ASSERT_EQ(0, switch_div(0));
  ASSERT_EQ(1, switch_mod(0));
  ASSERT_EQ(0, switch_mod(1));

  // `foo(void ...)` must be a compile error.
  string err = catch(load_object("/clone/a2_void_dots"));
  ASSERT_NE(0, err);

  ASSERT(1);
}
